<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="😂 Risas Enlatadas"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="32dp"
        android:text="Pixel 9 Material You • Hecho con amor por Wendy ✨"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btn_test_laugh"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="😂 Sonar Risas del Público"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_pin_widget"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="📌 Anclar Widget a Pantalla Principal" />

</LinearLayout>
